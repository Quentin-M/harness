#!/usr/bin/env bash
# shot <url> <out.png> [--viewport WxH] [--full]
#   Screenshot a page with headless Chromium (pinned Playwright, browsers under $STATE/playwright).
#   --viewport  window size, default 1280x800
#   --full      capture the full scrollable page
# Read the PNG back with an image-capable read tool before claiming what it shows.

source "$(dirname "$0")/lib.sh"
vp=1280x800 full=0 pos=()
while (($#)); do
  case $1 in
    -h|--help) usage ;;
    --viewport) vp=${2:?}; shift ;;
    --full) full=1 ;;
    *) pos+=("$1") ;;
  esac
  shift
done
((${#pos[@]} == 2)) || usage 1
pw shot "${pos[0]}" "$(abspath "${pos[1]}")" "$vp" "$full"
